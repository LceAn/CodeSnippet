# Flask MVC 环境变量示例

# 复制此文件为 .env 并填写实际值

# 安全密钥（生产环境必须修改）
SECRET_KEY=your-super-secret-key-change-in-production

# 数据库配置
# 开发环境（SQLite）
DEV_DATABASE_URL=sqlite:///development.db

# 生产环境（MySQL）
# DATABASE_URL=mysql+pymysql://user:password@localhost/production_db

# 日志目录
LOG_DIR=logs

# 应用环境
FLASK_ENV=development
FLASK_APP=manager.py
